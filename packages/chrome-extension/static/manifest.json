{
  "manifest_version": 3,
  "name": "tsforge",
  "version": "0.2.0",
  "description": "Lets your local tsforge agent read pages in your logged-in Chrome — read and navigate only, inside a 'tsforge' tab group.",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": ["tabs", "tabGroups", "scripting", "storage", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "options_page": "options.html",
  "action": { "default_title": "Share this tab with tsforge" }
}
