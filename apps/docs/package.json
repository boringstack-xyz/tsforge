{
  "name": "@tsforge/docs",
  "type": "module",
  "private": true,
  "version": "0.53.3",
  "description": "tsforge docs — Astro Starlight product site.",
  "scripts": {
    "sync:rules": "bun scripts/sync-rules-catalog.ts",
    "check:rules": "cd ../.. && bun run rules:build && git diff --exit-code packages/core/RULES.md",
    "sync:arch": "bun scripts/sync-architecture-catalog.ts",
    "check:arch": "cd ../.. && bun run arch:check",
    "sync:all": "bun run sync:rules && bun run sync:arch",
    "dev": "bun run sync:all && astro dev",
    "start": "bun run sync:all && astro dev",
    "build": "bun run sync:all && astro build",
    "build:ci": "bun run check:rules && bun run check:arch && bun run sync:all && astro build",
    "export:harness-board": "bun scripts/export-harness-board.mjs",
    "preview": "astro preview",
    "deploy": "bun run build:ci && wrangler deploy",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/react": "6.0.5",
    "@astrojs/sitemap": "3.7.3",
    "@astrojs/starlight": "0.41.10",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.2.9",
    "astro-mermaid": "2.1.0",
    "mermaid": "11.17.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "reading-time": "1.5.0",
    "remark-gfm": "4.0.1",
    "sharp": "0.35.3",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "wrangler": "4.127.1"
  }
}
